{
  "name": "parking-challenge",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal vertical-slice parking reservation challenge",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix apps/frontend start",
    "dev:backend": "node apps/backend/src/server.mjs",
    "build": "npm --prefix apps/frontend run build",
    "start": "node apps/backend/src/server.mjs",
    "test": "node --test \"apps/backend/src/**/*.spec.mjs\"",
    "postinstall": "npm --prefix apps/frontend install",
    "setup": "npm run db:reset",
    "db:reset": "node apps/backend/scripts/reset-db.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
